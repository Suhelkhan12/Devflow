generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  createdAt     DateTime       @default(now())
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole       @default(USER)
  updatedAt     DateTime       @updatedAt
  bio           String?
  location      String?
  portfolio     String?
  reputation    Int?           @default(0)
  accounts      Account[]
  answers       Answer[]
  bookmarks     Bookmark[]
  questions     Question[]
  activities    UserActivity[]
  votes         Vote[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Question {
  id           String         @id @default(uuid())
  title        String
  content      String
  upvotes      Int            @default(0)
  downvotes    Int            @default(0)
  totalAnswers Int            @default(0)
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userId       String
  answers      Answer[]
  bookmarks    Bookmark[]
  author       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags         QuestionTag[]
  activities   UserActivity[]
  votes        Vote[]
}

model Tag {
  id            String        @id @default(uuid())
  name          String        @unique
  totalQuestion Int           @default(0)
  description   String?
  questions     QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
}

model Answer {
  id         String         @id @default(uuid())
  upvotes    Int            @default(0)
  downvotes  Int            @default(0)
  createdAt  DateTime       @default(now())
  questionId String
  authorId   String
  content    String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  activities UserActivity[]
  votes      Vote[]
  @@unique([authorId, questionId])
}

model Vote {
  id         String    @id @default(uuid())
  votedOn    VotedOn
  voteType   Votetype
  createdAt  DateTime  @default(now())
  voterId    String
  questionId String?
  answerId   String?
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  voter      User      @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([voterId, questionId])
  @@unique([voterId, answerId])
}

model Bookmark {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  userId     String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserActivity {
  id         String       @id @default(uuid())
  type       ActivityType
  target     TargetType
  userId     String
  questionId String?
  answerId   String?
  createdAt  DateTime     @default(now())
  answer     Answer?      @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question   Question?    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, type])
  @@index([userId, createdAt])
}

enum UserRole {
  ADMIN
  USER
}

enum VotedOn {
  QUESTION
  ANSWER
}

enum Votetype {
  UPVOTE
  DOWNVOTE
}

enum ActivityType {
  VIEW
  BOOKMARK
  UNBOOKMARK
  UPVOTE
  DOWNVOTE
  ASK_QUESTION
  ANSWER_QUESTION
}

enum TargetType {
  QUESTION
  ANSWER
  USER
}
