generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  // url  	    = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}
enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  bio           String?
  location      String?
  portfolio     String?
  reputation    Int?      @default(0)

  accounts   Account[]
  questions  Question[]
  answers    Answer[]
  votes      Vote[]
  bookmarks  Bookmark[]
  activities UserActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// for security purpose it is safe to keep tokens separate for each function
model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// todo implement 2FA for the user as well.

model Question {
  id           String @id @default(uuid())
  title        String
  content      String
  upvotes      Int    @default(0)
  downvotes    Int    @default(0)
  totalAnswers Int    @default(0)
  views        Int    @default(0)

  userId String
  // user will be used as author itself no need to create separte
  author User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers    Answer[]
  tags       QuestionTag[]
  votes      Vote[]
  bookmarks  Bookmark[]
  activities UserActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id            String @id @default(uuid())
  name          String @unique
  description   String?
  totalQuestion Int    @default(0)

  questions QuestionTag[]
}

// this is how you create many to many rltn
model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
}

model Answer {
  id        String @id @default(uuid())
  content   String

  upvotes   Int    @default(0)
  downvotes Int    @default(0)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes      Vote[]
  activities UserActivity[]

  createdAt DateTime @default(now())
}

// this model will be used to keep track of what kind of vote is done by the user on q&a
enum VotedOn {
  QUESTION
  ANSWER
}

enum Votetype {
  UPVOTE
  DOWNVOTE
}

model Vote {
  id       String   @id @default(uuid())
  votedOn  VotedOn
  voteType Votetype

  voterId String
  voter   User   @relation(fields: [voterId], references: [id], onDelete: Cascade)

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerId String?
  answer   Answer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([voterId, questionId])
  @@unique([voterId, answerId])
}

// this is simply list of all the questions which has been bookmarked by the user
model Bookmark {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, questionId])
}

// for recomendation algorithms
enum ActivityType {
  VIEW
  BOOKMARK
  UNBOOKMARK
  UPVOTE
  DOWNVOTE
  ASK_QUESTION
  ANSWER_QUESTION
}

enum TargetType {
  QUESTION
  ANSWER
  USER
}

model UserActivity {
  id     String       @id @default(uuid())
  type   ActivityType
  target TargetType

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerId String?
  answer   Answer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@unique([userId, questionId, type])
}
