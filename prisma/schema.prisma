generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  bio           String?
  location      String?
  portfolio     String?
  reputation    Int?      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  questions Question[]
  answers Answer[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// for security purpose it is safe to keep tokens separate for each function
model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// todo implement 2FA for the user as well.

model Question{
  id String @id @default(uuid())
  title String 
  content String
  upvotes Int @default(0)
  downvotes  Int @default(0)
  totalAnswers Int @default(0)
  views Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  // user will be used as author itself no need to create separte
  author User @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers Answer[]
  tags QuestionTag[]
}

model Tag{
  id String @id @default(uuid())
  name String

  questions QuestionTag[]
}

// this is how you create many to many rltn
model QuestionTag{
  questionId String
  tagId String

  question Question @relation(fields: [questionId], references: [id])
  tag Tag @relation(fields: [tagId], references: [id])

  @@id([questionId, tagId])
}

model Answer{
  id String @id @default(uuid())
  upvotes Int @default(0)
  downvotes Int @default(0)
  createdAt DateTime @default(now())

  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

